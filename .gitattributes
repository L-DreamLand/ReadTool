# 归一化换行，避免 Windows 开发、Linux 部署时整文件 diff
* text=auto eol=lf

# 明确二进制，避免被当文本处理
*.zip   binary
*.exe   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary

# 文档与源码统一 LF
*.md    text eol=lf
*.go    text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.sha256 text eol=lf
